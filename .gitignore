# pyenv
#   For a library or package, you might want to ignore these files since the code is intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if the platform is not identical for all developers and some compile-dependencies are used, Pipfile.lock may break the installation.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#   This is especially true for applications, but less so for libraries.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in a version control.
#pdm.lock
.pdm-plugins/
.pdm-python/

# PEP 582; used by e.g. github.com/pypa/pdm
__pypackages__/

